# ---------------------------------------------------------------------------
# OpenBot API - sample configuration
# copy to .env (or let scripts/devdb.py generate .env.local for local dev)
# ---------------------------------------------------------------------------
APP_APP_ENV=dev
APP_DEBUG=true
# NOTE: the field is `app_env`, and Settings uses env_prefix="APP_", so the
# variable must be APP_APP_ENV. A plain APP_ENV is silently ignored.
# display name (brand); leave empty to use the default "کاروند"
APP_APP_NAME=کاروند

# --- database ---------------------------------------------------------------
# application role (non-superuser -> row level security is enforced)
APP_DATABASE_URL=postgresql+asyncpg://openbot_app:openbot@127.0.0.1:5432/openbot
# role used only by alembic (needs CREATE EXTENSION)
APP_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:@127.0.0.1:5432/openbot

# --- security ---------------------------------------------------------------
# base64 of 32 random bytes:  python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APP_JWT_SECRET=change-me
APP_MASTER_KEY=
APP_ACCESS_TOKEN_TTL_MIN=15
APP_REFRESH_TOKEN_TTL_DAYS=7

# --- persian defaults -------------------------------------------------------
APP_DEFAULT_LOCALE=fa
APP_DEFAULT_TIMEZONE=Asia/Tehran
APP_DEFAULT_CALENDAR=jalali
APP_DEFAULT_CURRENCY=IRR
APP_DEFAULT_DIGITS=fa
APP_FX_USD_IRR=0

# --- commercial flags -------------------------------------------------------
APP_FREE_MODE=true
APP_BILLING_ENABLED=false
APP_PAYMENT_GATEWAY=noop
# USD -> Toman price multiplier applied to every model price
APP_PLATFORM_MARKUP_PERCENT=30
APP_MIN_TOPUP_IRR=100000

# --- phone OTP login --------------------------------------------------------
APP_OTP_TTL_SECONDS=120
APP_OTP_LENGTH=5
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_COOLDOWN_SECONDS=60
APP_OTP_DAILY_LIMIT_PER_PHONE=10
APP_OTP_DAILY_LIMIT_PER_IP=30
# dev only: echo the code in the API response instead of waiting for an SMS
APP_OTP_DEBUG_CODE=false

# --- SMS (FarazSMS) ---------------------------------------------------------
APP_SMS_ENABLED=false
APP_SMS_PROVIDER=farazsms
APP_FARAZSMS_BASE_URL=https://api2.farazsms.com/api/igm
APP_FARAZSMS_API_KEY=
APP_FARAZSMS_SENDER=
# pattern (الگو) code registered for the OTP template; empty = plain text
APP_FARAZSMS_OTP_PATTERN=

# --- payment gateway (Zarinpal) ---------------------------------------------
APP_PAYMENT_GATEWAY=noop
# 36 character merchant id from the Zarinpal panel
APP_ZARINPAL_MERCHANT_ID=
# true -> talk to sandbox.zarinpal.com (test money, no real charge)
APP_ZARINPAL_SANDBOX=false
# empty -> https://payment.zarinpal.com (or the sandbox host)
APP_ZARINPAL_BASE_URL=
APP_PAYMENT_TIMEOUT_SECONDS=15
# absolute URL the gateway redirects back to; empty -> derived from the request
# (production: https://kaarvand.amigok.cloud/v1/wallet/topup/callback)
APP_PAYMENT_CALLBACK_URL=
# where the callback sends the customer next (deep link of the client app)
APP_PAYMENT_RETURN_URL=kaarvand://wallet

APP_CORS_ORIGINS=["http://localhost:3000"]
